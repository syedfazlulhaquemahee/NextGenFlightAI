# Copy the values below into your local .env file. Do not commit .env.
# Set these to the SMTP credentials from your email provider before enabling
# production account emails.

# SMTP delivery (STARTTLS is the typical provider configuration)
NGF_EMAIL_ENABLED=true
NGF_SMTP_HOST=smtp.your-provider.example
NGF_SMTP_PORT=587
NGF_SMTP_USERNAME=your-smtp-username
NGF_SMTP_PASSWORD=your-smtp-password-or-api-key
NGF_SMTP_USE_TLS=true
NGF_SMTP_USE_SSL=false
NGF_SMTP_TIMEOUT_SECONDS=10

# Sender identity. Use a verified sender/domain configured with your provider.
NGF_EMAIL_FROM=no-reply@your-domain.example
NGF_EMAIL_FROM_NAME=Skairova
NGF_EMAIL_REPLY_TO=support@your-domain.example

# Public URL used in links within account emails.
NGF_PUBLIC_BASE_URL=https://your-domain.example

# Keep disabled outside local development: reset codes must only be delivered
# by email in production.
NGF_EMAIL_DEV_CODE_FALLBACK=false
