# Copy the values below into your local .env file. Do not commit .env.

# Required for every production / preview deployment. This must be one stable,
# high-entropy value shared by every server instance; otherwise signed sessions
# and CSRF-protected forms (signup, sign-in, sign-out, password reset) fail.
# Generate it once with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-one-stable-production-secret
NGF_SESSION_COOKIE_SECURE=true

# Persistent account storage for Vercel (Supabase Transaction Pooler URI).
# URL-encode password characters such as %, @, :, /, and # before placing
# them in a URI.
NGF_DATABASE_URL=postgresql://postgres.project-ref:your-url-encoded-password@aws-0-region.pooler.supabase.com:6543/postgres

# Account data defaults to local SQLite. On Vercel it is automatically moved
# to /tmp so signup will not crash, but that storage is temporary and may be
# cleared between serverless instances. Set this only when a persistent
# writable disk/database bridge is available.
# NGF_ACCOUNTS_DB_PATH=/path/to/persistent/accounts.db

# Set these to the SMTP credentials from your email provider before enabling
# production account emails.

# SMTP delivery (STARTTLS is the typical provider configuration)
NGF_EMAIL_ENABLED=true
NGF_SMTP_HOST=smtp.your-provider.example
NGF_SMTP_PORT=587
NGF_SMTP_USERNAME=your-smtp-username
NGF_SMTP_PASSWORD=your-smtp-password-or-api-key
NGF_SMTP_USE_TLS=true
NGF_SMTP_USE_SSL=false
NGF_SMTP_TIMEOUT_SECONDS=10

# Sender identity. Use a verified sender/domain configured with your provider.
NGF_EMAIL_FROM=no-reply@your-domain.example
NGF_EMAIL_FROM_NAME=Skairova
NGF_EMAIL_REPLY_TO=support@your-domain.example

# Public URL used in links within account emails.
NGF_PUBLIC_BASE_URL=https://your-domain.example

# Keep disabled outside local development: reset codes must only be delivered
# by email in production.
NGF_EMAIL_DEV_CODE_FALLBACK=false
